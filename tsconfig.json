{
  "compilerOptions": {
    "paths": {
      "@core/*": ["./src/core/*"],
      "@underworld/*": ["./src/package/underworld/*"],
      "@supernova/common/*": ["./packages/common/src/*"],
      "@supernova/common": ["./packages/common/src/index.ts"],
      "@supernova/events/*": ["./packages/events/src/*"],
      "@supernova/events": ["./packages/events/src/index.ts"],
      "@supernova/storage/*": ["./packages/storage/src/*"],
      "@supernova/storage": ["./packages/storage/src/index.ts"],
      "@supernova/runtime/*": ["./packages/runtime/src/*"],
      "@supernova/runtime": ["./packages/runtime/src/index.ts"]
    },
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["bun"]
  },
  "exclude": [".dev/web", "./node_modules", "./src/package"]
}
