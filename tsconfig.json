{
  "compilerOptions": {
    "paths": {
      "@core/*": ["./src/core/*"],
      "@underworld/*": ["./src/package/underworld/*"]
    },
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["bun"]
  },
  "exclude": ["web", "./node_modules"]
}
