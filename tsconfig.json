{
  "compilerOptions": {
    "paths": {
      "@core/*": ["./src/core/*"],
      "@underworld/*": ["./src/package/underworld/*"],
      "@supernova/common/*": ["./packages/common/src/*"],
      "@supernova/events/*": ["./packages/events/src/*"],
      "@supernova/storage/*": ["./packages/storage/src/*"],
      "@supernova/runtime/*": ["./packages/runtime/src/*"]
    },
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["bun"]
  },
  "exclude": ["web", "./node_modules"]
}
